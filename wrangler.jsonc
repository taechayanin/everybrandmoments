{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moment-os",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  "vars": {
    "MOMENT_OS_DATA_SOURCE": "d1"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moment-os",
      "database_id": "600b9e6e-55ae-4415-8a2c-9ebbd4446063",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "moment-os-files"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "MOMENT_JOBS",
        "queue": "moment-os-jobs"
      }
    ]
  }
}
